{
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && CI=false npm run build",
  "outputDirectory": "frontend/build",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/images/[...path].js": {
      "includeFiles": [
        "public/images/**",
        "backend/public/images/**"
      ]
    }
  }
}

